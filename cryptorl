# LstmAttentionExtractor 类保持不变 (使用 Tanh 激活)
print("定义自定义网络架构 LstmAttentionExtractor (使用 Tanh 激活)...")
class LstmAttentionExtractor(BaseFeaturesExtractor):
    """
    结合 LSTM 和 Self-Attention 的特征提取器 for PPO (v4 RiskAdjPnL)
    - 最后全连接层后使用 Tanh 激活函数

    Args:
        observation_space (gym.Space): 环境的观测空间
        features_dim (int): 输出特征向量的维度
        lstm_hidden_size (int): LSTM 隐藏层大小
        n_lstm_layers (int): LSTM 层数
        n_attention_heads (int): Self-Attention 头数
    """
    # 更新: 修改 n_attention_heads 默认值
    def __init__(self, observation_space: spaces.Box, features_dim: int = 256,
                 lstm_hidden_size: int = 128, n_lstm_layers: int = 2, n_attention_heads: int = 4): # 更新默认值
        super().__init__(observation_space, features_dim)

        if len(observation_space.shape) != 2:
             raise ValueError(f"Expected observation space shape of (window_size, num_features), got {observation_space.shape}")

        self.window_size, self.input_features = observation_space.shape
        self.lstm_hidden_size = lstm_hidden_size
        self.n_lstm_layers = n_lstm_layers

        self.lstm = nn.LSTM(input_size=self.input_features, hidden_size=lstm_hidden_size,
                            num_layers=n_lstm_layers, batch_first=True)

        attention_embed_dim = lstm_hidden_size
        if attention_embed_dim <= 0: raise ValueError(f"LSTM hidden size must be positive, got {attention_embed_dim}")
        # 使用传入的 n_attention_heads
        current_n_attention_heads = n_attention_heads
        if current_n_attention_heads <= 0: current_n_attention_heads = 1
        while attention_embed_dim % current_n_attention_heads != 0 and current_n_attention_heads > 1: current_n_attention_heads -= 1
        if attention_embed_dim % current_n_attention_heads != 0:
             current_n_attention_heads = 1
             print(f"警告: LSTM隐藏层大小 {attention_embed_dim} 不能被注意力头数 {n_attention_heads} 整除。将头数调整为 {current_n_attention_heads}。")
        self.n_attention_heads = current_n_attention_heads

        self.attention = nn.MultiheadAttention(embed_dim=attention_embed_dim, num_heads=self.n_attention_heads, batch_first=True)
        self.fc = nn.Linear(attention_embed_dim, features_dim)
        self.tanh = nn.Tanh()

    def forward(self, observations: torch.Tensor) -> torch.Tensor:
        if observations.dtype != torch.float32: observations = observations.float()
        lstm_out, _ = self.lstm(observations)
        attn_output, attn_weights = self.attention(lstm_out, lstm_out, lstm_out)
        last_step_attn_output = attn_output[:, -1, :]
        features = self.tanh(self.fc(last_step_attn_output))
        return features

