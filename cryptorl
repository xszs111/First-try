        short_entry = trade_history_plot[trade_history_plot['action'].str.contains("Open Short", case=False, na=False)]
        long_exit = trade_history_plot[trade_history_plot['action'].str.contains("Close Long|Stop Loss Long|End Close Long", case=False, na=False)]
        short_exit = trade_history_plot[trade_history_plot['action'].str.contains("Cover Short|Stop Loss Short|End Cover Short|Liquidation", case=False, na=False)] # Liquidation 也算退出

