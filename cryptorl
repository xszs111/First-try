        ax1.plot(short_entry['timestamp'], short_entry['price'], 'v', markersize=8, color='red', label='开空仓', alpha=0.8, linestyle='None')
        ax1.plot(short_exit['timestamp'], short_exit['price'], 'x', markersize=8, color='magenta', label='平空仓', alpha=0.8, linestyle='None')


    ax1.set_ylabel('价格 (USDT)', fontsize=12); ax1.legend(loc='upper left'); ax1.grid(True, linestyle='--', alpha=0.5)

    equity_curve = step_history_df.set_index('timestamp')['equity']
    ax2.plot(equity_curve.index, equity_curve, label='账户权益', color='darkorange', linewidth=1.5)
    ax2.set_xlabel('时间', fontsize=12); ax2.set_ylabel('权益 (USDT)', fontsize=12); ax2.legend(loc='upper left'); ax2.grid(True, linestyle='--', alpha=0.5)
    ax2.xaxis.set_major_formatter(mdates.DateFormatter('%Y-%m-%d')); plt.xticks(rotation=45, ha='right')

    plt.tight_layout(rect=[0, 0.03, 1, 0.95])
    try:
        plt.rcParams['font.sans-serif'] = ['SimHei']; plt.rcParams['axes.unicode_minus'] = False
    except Exception as font_e: print(f"设置中文字体失败: {font_e}.")
