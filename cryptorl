print("定义交易环境 TradingEnv (使用 Price Trailing 奖励)...")
class TradingEnv(gym.Env):
    """
    一个用于加密货币交易的 Gym 环境 (v5 PriceTrailing Clarified)
    - 使用预先标准化的数据
    - 使用 Price Trailing 组合奖励 (简化版)

    Args:
        df (pd.DataFrame): 包含已标准化的 OHLCV 和指标的数据
        df_raw (pd.DataFrame): 包含原始价格和回报率 ('returns') 的数据
        indicator_cols (list): 用作状态一部分的指标列名列表 (已标准化)
        window_size (int): 用于构建状态的回看时间窗口大小
        initial_balance (float): 初始账户余额
        commission_rate (float): 每次交易的手续费率
        spread (float): 买卖价差的模拟百分比
        leverage (float): 杠杆倍数
        margin_call_threshold (float): 维持保证金率低于此值时触发爆仓
        stop_loss_threshold (float): 可选的止损百分比
        # Price Trailing 相关参数
        pt_margin (float): 价格追踪的保证金比例 m (e.g., 0.02 for 2%)
        pt_step (float): 智能体价格更新步长 v (e.g., 0.1 for 10%)
        # 奖励权重
        a_trail (float): 追踪奖励权重
        a_pnl (float): PnL 奖励权重
        a_fee (float): 交易费惩罚权重
        # 奖励归一化统计量 (从训练集计算得到)
        sigma_z (float): 训练集回报率标准差
        mu_abs_z (float): 训练集回报率绝对值的均值
    """
    metadata = {'render_modes': ['human', 'ansi'], 'render_fps': 1}

    # 更新: 修改 __init__ 默认值以匹配新参数
    def __init__(self, df, df_raw, indicator_cols, window_size=64, initial_balance=10000.0,
                 commission_rate=0.001, spread=0.0001, leverage=1.0, # 更新 spread, leverage
                 margin_call_threshold=0.5, stop_loss_threshold=None,
                 pt_margin=0.02, pt_step=0.01, # Price Trailing 参数默认值
                 a_trail=0.2, a_pnl=0.7, a_fee=0.1, # 奖励权重默认值
                 sigma_z=1.0, mu_abs_z=1.0 # 归一化统计量
                 ):

        super().__init__()

        if df.empty or len(df) <= window_size or df_raw.empty or len(df_raw) != len(df):
            raise ValueError("DataFrame 数据为空、长度不足或标准化与原始数据长度不匹配")
        if 'returns' not in df_raw.columns:
             raise ValueError("原始 DataFrame (df_raw) 缺少 'returns' 列")


        self.df = df.copy()
        self.df_raw = df_raw.copy()
        self.indicator_cols = indicator_cols
        self.window_size = window_size # 使用传入的 window_size
        self.initial_balance = initial_balance
        self.commission_rate = commission_rate
        self.spread = spread # 使用传入的 spread
        self.leverage = leverage # 使用传入的 leverage
        self.margin_call_threshold = margin_call_threshold
        self.stop_loss_threshold = stop_loss_threshold

        # Price Trailing & Reward Params
        self.pt_margin = pt_margin
        self.pt_step = pt_step
        self.a_trail = a_trail
        self.a_pnl = a_pnl
        self.a_fee = a_fee
        # 存储从外部传入的归一化统计量
        self.sigma_z = sigma_z
        self.mu_abs_z = mu_abs_z

        # 状态空间: [窗口内的标准化OHLCV, 窗口内的标准化指标, 持仓状态]
        state_feature_dim = 5 + len(indicator_cols)
        self.observation_shape = (window_size, state_feature_dim + 1)
        self.observation_space = spaces.Box(low=-np.inf, high=np.inf, shape=self.observation_shape, dtype=np.float32)

        # 动作空间: 0: Hold, 1: Long, 2: Short
        self.action_space = spaces.Discrete(3)

        self._validate_df()
        self._reset_state()

    def _validate_df(self):
        # (保持不变)
        required_cols_scaled = ['timestamp', 'open', 'high', 'low', 'close', 'volume'] + self.indicator_cols
        for col in required_cols_scaled:
            if col not in self.df.columns: raise ValueError(f"标准化 DataFrame 缺少必需列: {col}")
            if not pd.api.types.is_numeric_dtype(self.df[col]) and col != 'timestamp': raise ValueError(f"标准化 DataFrame 列 '{col}' 必须是数值类型")
        required_cols_raw = ['timestamp', 'open', 'high', 'low', 'close', 'volume', 'returns']
        for col in required_cols_raw:
            if col not in self.df_raw.columns: raise ValueError(f"原始 DataFrame 缺少必需列: {col}")
            if not pd.api.types.is_numeric_dtype(self.df_raw[col]) and col != 'timestamp': raise ValueError(f"原始 DataFrame 列 '{col}' 必须是数值类型")


    def _reset_state(self):
        """重置环境内部状态"""
        self.current_step = self.window_size
        self.balance = self.initial_balance
        self.equity = self.initial_balance
        self.position = 0
        self.last_position = 0
        self.position_size = 0.0
        self.entry_price = 0.0
        self.margin_used = 0.0
        self.total_fees = 0.0
        self.trade_history = []
        self.step_history = []
        safe_start_index = min(self.current_step, len(self.df_raw) - 1)
        self.agent_price = self.df_raw.iloc[safe_start_index]['close']

    def reset(self, seed=None, options=None):
        """重置环境到初始状态"""
        super().reset(seed=seed)
        self._reset_state()
        observation = self._get_observation()
        info = self._get_info()
        self.step_history.append(info)
        return observation, info

    # _get_observation 方法保持不变
    def _get_observation(self):
        """获取当前时间步的状态 (使用预标准化的数据)"""
        start_idx = max(0, self.current_step - self.window_size)
        end_idx = self.current_step
        obs_df = self.df.iloc[start_idx:end_idx] # 使用标准化后的 df

        if len(obs_df) < self.window_size:
            padding_size = self.window_size - len(obs_df)
            padding_df = pd.DataFrame(np.zeros((padding_size, len(self.df.columns))), columns=self.df.columns)
            obs_df = pd.concat([padding_df, obs_df], ignore_index=True)

        obs = np.zeros(self.observation_shape, dtype=np.float32)
        obs[:, 0] = obs_df['open'].values
        obs[:, 1] = obs_df['high'].values
        obs[:, 2] = obs_df['low'].values
        obs[:, 3] = obs_df['close'].values
        obs[:, 4] = obs_df['volume'].values
        for i, col in enumerate(self.indicator_cols):
             obs[:, 5 + i] = obs_df[col].values
        obs[:, -1] = self.position # 使用当前的 self.position
        return obs

    # _get_info 方法保持不变
    def _get_info(self):
        """获取当前时间步的辅助信息"""
        safe_step = min(self.current_step, len(self.df) - 1)
        current_raw_price = self.df_raw.iloc[safe_step]['close']
        return {
            "step": self.current_step,
            "timestamp": self.df.iloc[safe_step]['timestamp'],
            "balance": self.balance,
            "equity": self.equity,
            "current_price_raw": current_raw_price,
            "position": self.position,
            "position_size": self.position_size,
            "entry_price": self.entry_price,
            "margin_used": self.margin_used,
            "total_fees": self.total_fees,
            "agent_price": self.agent_price
        }

    # _calculate_reward 方法保持不变 (已修复费用项)
    def _calculate_reward(self):
        """计算奖励信号 (Price Trailing 组合奖励) - v5 Clarified"""
        safe_step = min(self.current_step, len(self.df_raw) - 1)
        current_raw_price = self.df_raw.iloc[safe_step]['close']
        current_return = self.df_raw.iloc[safe_step]['returns'] # z_t

        # 1. 计算 Trailing Reward (r_trail)
        target_price = current_raw_price
        if target_price > 1e-8 and self.pt_margin > 1e-8:
            price_diff_ratio = abs(self.agent_price - target_price) / (self.pt_margin * target_price)
            r_trail_raw = max(0, 1 - price_diff_ratio)
            if price_diff_ratio > 1: r_trail_raw = -price_diff_ratio # 超出边界惩罚
        else: r_trail_raw = 0.0
        # 归一化 Trailing Reward (依据文献式 9)
        # r_trail * (mu_|z| / sigma_z)
        r_trail_normalized = r_trail_raw * self.mu_abs_z / self.sigma_z

        # 2. 计算 PnL Reward (r_pnl)
        r_pnl_raw = self.position * current_return # delta_t * z_t
        # 归一化 PnL Reward (依据文献式 7)
        # r_pnl / sigma_z
        r_pnl_normalized = r_pnl_raw / self.sigma_z

        # 3. 计算 Fee Reward (r_fee)
        position_change = abs(self.position - self.last_position) # 0, 1, or 2
        # 原始费用惩罚 (与文献定义 -c * |delta_t - delta_{t-1}| 一致, c=commission_rate)
        fee_penalty_raw = -self.commission_rate * position_change
        # 归一化 Fee Reward (依据文献式 8)
        # r_fee / sigma_z (注意：此归一化方式的理论依据可能需进一步探讨)
        r_fee_normalized = fee_penalty_raw / self.sigma_z

        # 4. 计算组合奖励 (依据文献式 10)
        total_reward = (self.a_trail * r_trail_normalized +
                        self.a_pnl * r_pnl_normalized +
                        self.a_fee * r_fee_normalized) # 已加入费用项

        return total_reward

    # _apply_commission_and_spread 方法保持不变
    def _apply_commission_and_spread(self, price_raw, size, is_buy):
        """计算手续费和模拟价差影响 (使用原始价格)"""
        commission = abs(size) * price_raw * self.commission_rate
        if is_buy: effective_price_raw = price_raw * (1 + self.spread / 2)
        else: effective_price_raw = price_raw * (1 - self.spread / 2)
        cost_or_revenue = abs(size) * effective_price_raw
        return commission, effective_price_raw, cost_or_revenue

    # _update_position 方法保持不变 (Hold=NoChange)
    def _update_position(self, action):
        """根据动作更新持仓状态，并更新 agent_price (v5 Fix: Hold=NoChange)"""
        if self.current_step >= len(self.df):
             print(f"警告: _update_position 尝试访问超出范围的索引 {self.current_step}")
             current_raw_price = self.df_raw.iloc[-1]['close']
        else:
             current_raw_price = self.df_raw.iloc[self.current_step]['close']

        self.last_position = self.position
        step_pnl = 0.0; fees = 0.0; executed_price_raw = current_raw_price; trade_size = 0

        if self.equity > 0 and self.leverage > 0:
            trade_amount_usd = self.equity * 0.9 / self.leverage # 使用杠杆计算可交易名义价值
            trade_amount_usd = max(trade_amount_usd, 1e-6)
        else: trade_amount_usd = 0

        target_position = self.position # Hold=NoChange
        if action == 1: target_position = 1
        elif action == 2: target_position = -1

        # 平仓逻辑 (仅当目标与当前相反)
        if self.position != 0 and target_position != self.position and target_position != 0:
            if self.position == 1: # 平多
                step_pnl = (current_raw_price - self.entry_price) * abs(self.position_size)
                fees_close, executed_price_close_raw, _ = self._apply_commission_and_spread(current_raw_price, abs(self.position_size), is_buy=False)
                self.balance += step_pnl - fees_close; self.total_fees += fees_close
                self._record_trade(action="Close Long", price=executed_price_close_raw, size=abs(self.position_size), fees=fees_close, pnl=step_pnl)
                self.position = 0; self.position_size = 0; self.entry_price = 0; self.margin_used = 0; fees += fees_close
            elif self.position == -1: # 平空
                step_pnl = (self.entry_price - current_raw_price) * abs(self.position_size)
                fees_close, executed_price_close_raw, _ = self._apply_commission_and_spread(current_raw_price, abs(self.position_size), is_buy=True)
                self.balance += step_pnl - fees_close; self.total_fees += fees_close
                self._record_trade(action="Close Short", price=executed_price_close_raw, size=abs(self.position_size), fees=fees_close, pnl=step_pnl)
                self.position = 0; self.position_size = 0; self.entry_price = 0; self.margin_used = 0; fees += fees_close

        # 开仓逻辑 (仅当当前空仓且目标非空)
        if self.position == 0 and target_position != 0:
            if target_position == 1 and trade_amount_usd > 0 and current_raw_price > 0: # 开多
                trade_size = trade_amount_usd / current_raw_price
                fees_open, executed_price_open_raw, cost = self._apply_commission_and_spread(current_raw_price, trade_size, is_buy=True)
                required_margin = cost / self.leverage # 保证金基于实际成本
                if self.balance >= required_margin + fees_open:
                    self.position = 1; self.position_size = trade_size; self.entry_price = executed_price_open_raw
                    self.margin_used = required_margin; self.balance -= fees_open; self.total_fees += fees_open
                    self._record_trade(action="Open Long", price=executed_price_open_raw, size=trade_size, fees=fees_open, pnl=0)
                    fees += fees_open; executed_price_raw = executed_price_open_raw
            elif target_position == -1 and trade_amount_usd > 0 and current_raw_price > 0: # 开空
                trade_size = trade_amount_usd / current_raw_price
                fees_open, executed_price_open_raw, revenue = self._apply_commission_and_spread(current_raw_price, trade_size, is_buy=False)
                required_margin = revenue / self.leverage # 保证金基于名义价值
                if self.balance >= required_margin + fees_open:
                    self.position = -1; self.position_size = trade_size; self.entry_price = executed_price_open_raw
                    self.margin_used = required_margin; self.balance -= fees_open; self.total_fees += fees_open
                    self._record_trade(action="Open Short", price=executed_price_open_raw, size=trade_size, fees=fees_open, pnl=0)
                    fees += fees_open; executed_price_raw = executed_price_open_raw

        # 更新 Agent Price
        target_price = current_raw_price
        if target_price > 1e-8 and self.pt_margin > 1e-8:
            upper_margin = target_price * (1 + self.pt_margin); lower_margin = target_price * (1 - self.pt_margin)
            if self.position == 1: self.agent_price += self.pt_step * abs(upper_margin - self.agent_price)
            elif self.position == -1: self.agent_price -= self.pt_step * abs(self.agent_price - lower_margin)
            self.agent_price = np.clip(self.agent_price, lower_margin + 1e-9, upper_margin - 1e-9)
            self.agent_price = max(self.agent_price, 1e-9)

        # 更新权益和检查爆仓
        unrealized_pnl = 0
        if self.current_step < len(self.df): current_raw_price_for_pnl = self.df_raw.iloc[self.current_step]['close']
        else: current_raw_price_for_pnl = self.df_raw.iloc[-1]['close']
        if self.position == 1: unrealized_pnl = (current_raw_price_for_pnl - self.entry_price) * abs(self.position_size)
        elif self.position == -1: unrealized_pnl = (self.entry_price - current_raw_price_for_pnl) * abs(self.position_size)
        self.equity = self.balance + unrealized_pnl

        # 爆仓和止损检查逻辑 (保持不变)
        terminated = False
        if self.position != 0 and self.margin_used > 1e-8:
            maintenance_margin_ratio = self.equity / self.margin_used
            if maintenance_margin_ratio < self.margin_call_threshold:
                print(f"--- 爆仓! Step: {self.current_step}, Equity: {self.equity:.2f}, Margin Used: {self.margin_used:.2f}, Ratio: {maintenance_margin_ratio:.4f} < {self.margin_call_threshold} ---")
                liquidation_pnl = unrealized_pnl; self.balance = self.equity
                self._record_trade(action="Liquidation", price=current_raw_price_for_pnl, size=abs(self.position_size), fees=0, pnl=liquidation_pnl)
                self.position = 0; self.position_size = 0; self.entry_price = 0; self.margin_used = 0
                self.equity = max(0, self.balance); self.balance = self.equity; terminated = True

        if not terminated and self.stop_loss_threshold is not None and self.position != 0 and self.margin_used > 1e-8:
             pnl_ratio = unrealized_pnl / self.margin_used
             if pnl_ratio < -self.stop_loss_threshold:
                 print(f"--- 止损! Step: {self.current_step}, PNL Ratio: {pnl_ratio:.2f} < {-self.stop_loss_threshold} ---")
                 sl_fees = 0; sl_pnl = 0; sl_price = current_raw_price_for_pnl
                 if self.position == 1: # 平多
                     sl_pnl = (sl_price - self.entry_price) * abs(self.position_size)
                     sl_fees, sl_exec_price, _ = self._apply_commission_and_spread(sl_price, abs(self.position_size), is_buy=False)
                     self._record_trade(action="Stop Loss Long", price=sl_exec_price, size=abs(self.position_size), fees=sl_fees, pnl=sl_pnl)
                 elif self.position == -1: # 平空
                     sl_pnl = (self.entry_price - sl_price) * abs(self.position_size)
                     sl_fees, sl_exec_price, _ = self._apply_commission_and_spread(sl_price, abs(self.position_size), is_buy=True)
                     self._record_trade(action="Stop Loss Short", price=sl_exec_price, size=abs(self.position_size), fees=sl_fees, pnl=sl_pnl)
                 self.balance += sl_pnl - sl_fees; self.total_fees += sl_fees
                 self.position = 0; self.position_size = 0; self.entry_price = 0; self.margin_used = 0
                 self.equity = self.balance

        if self.equity <= 1e-6:
            if not terminated:
                print(f"--- 权益耗尽! Step: {self.current_step}, Equity: {self.equity:.2f} ---")
                self.balance = 0; self.equity = 0
                if self.position != 0:
                     self._record_trade(action="Equity Zero Close", price=current_raw_price_for_pnl, size=abs(self.position_size), fees=0, pnl=unrealized_pnl)
                     self.position = 0; self.position_size = 0; self.entry_price = 0; self.margin_used = 0
                terminated = True

        return terminated, step_pnl

    # _record_trade 方法保持不变
    def _record_trade(self, action, price, size, fees, pnl):
        """记录交易详情 (使用原始价格)"""
        safe_step = min(self.current_step, len(self.df) - 1)
        self.trade_history.append({
            "step": self.current_step,
            "timestamp": self.df.iloc[safe_step]['timestamp'],
            "action": action,
            "price": price, # 记录的是原始执行价格
            "size": size,
            "fees": fees,
            "step_pnl": pnl,
            "balance": self.balance,
            "equity": self.equity,
            "position": self.position
        })

    # step 方法更新，使用新的奖励函数
    def step(self, action):
        """执行一个时间步 (使用 Price Trailing 组合奖励)"""
        if self.current_step >= len(self.df) - 1:
             obs = self._get_observation()
             info = self._get_info()
             return obs, 0.0, True, True, info

        terminated = False
        truncated = False

        # 应用动作，更新持仓，计算已实现盈亏，并更新 agent_price
        terminated, step_pnl = self._update_position(action)

        # 计算 Price Trailing 组合奖励
        reward = self._calculate_reward()
        # self.last_equity 在这里不再直接用于奖励计算

        # 记录当前步的信息
        info = self._get_info()
        self.step_history.append(info)

        # 移动到下一个时间步
        self.current_step += 1

        # 检查是否到达数据末尾并处理最终平仓
        if self.current_step >= len(self.df):
            truncated = True
            if self.position != 0 and not terminated:
                final_raw_price = self.df_raw.iloc[-1]['close']
                final_pnl = 0; final_fees = 0
                if self.position == 1:
                    final_pnl = (final_raw_price - self.entry_price) * abs(self.position_size)
                    final_fees, final_exec_price, _ = self._apply_commission_and_spread(final_raw_price, abs(self.position_size), is_buy=False)
                    self._record_trade(action="End Close Long", price=final_exec_price, size=abs(self.position_size), fees=final_fees, pnl=final_pnl)
                elif self.position == -1:
                    final_pnl = (self.entry_price - final_raw_price) * abs(self.position_size)
                    final_fees, final_exec_price, _ = self._apply_commission_and_spread(final_raw_price, abs(self.position_size), is_buy=True)
                    self._record_trade(action="End Cover Short", price=final_exec_price, size=abs(self.position_size), fees=final_fees, pnl=final_pnl)

                if not terminated:
                    self.balance += final_pnl - final_fees
                    self.total_fees += final_fees
                    self.position = 0; self.position_size = 0; self.entry_price = 0; self.margin_used = 0
                    self.equity = self.balance

        # 获取下一个状态
        observation = self._get_observation()
        # 更新 info
        info = self._get_info()

        # 结束惩罚
        if terminated and self.equity <= 1e-6:
            # 惩罚值可以根据 reward_scaling 调整，或者设为一个固定的负值
            reward -= 1.0 # 例如，一个固定的负奖励

        return observation, reward, terminated, truncated, info

    # render 和 close 方法保持不变
    def render(self, mode='human'):
        safe_step = min(self.current_step, len(self.df) - 1)
        if mode == 'human':
            print(f"Step: {self.current_step}, Timestamp: {self.df.iloc[safe_step]['timestamp']}")
            print(f"  Balance: {self.balance:.2f}, Equity: {self.equity:.2f}, Position: {self.position} ({self.position_size:.4f} @ {self.entry_price:.2f})")
            print(f"  Margin Used: {self.margin_used:.2f}, Total Fees: {self.total_fees:.2f}")
        elif mode == 'ansi':
            return f"Step: {self.current_step}, Equity: {self.equity:.2f}, Position: {self.position}"

    def close(self):
        print("环境关闭。")


