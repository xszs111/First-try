# 6. 评估模块 (Evaluate)
# ==============================================================================
# evaluate_agent 函数保持不变
print("定义评估模块...")

def evaluate_agent(agent, env):
    """评估训练好的 Agent"""
    obs, info = env.reset()
    terminated = False; truncated = False; total_reward = 0.0

    while not terminated and not truncated:
        action, _states = agent.predict(obs, deterministic=True)
        obs, reward, terminated, truncated, info = env.step(action)
        total_reward += reward

    trade_history_df = pd.DataFrame(env.trade_history)
    step_history_df = pd.DataFrame(env.step_history)
    final_equity = env.equity

    if not step_history_df.empty:
         equity_curve = step_history_df.set_index('timestamp')['equity']
         returns = equity_curve.pct_change().dropna()
         std_dev = returns.std()
         if len(returns) > 1 and std_dev > 1e-8:
             days = (step_history_df['timestamp'].iloc[-1] - step_history_df['timestamp'].iloc[0]).days
             days = max(days, 1)
             steps_per_year = (365.0 / days) * len(returns)
             sharpe_ratio = (returns.mean() / std_dev) * np.sqrt(steps_per_year)
         else: sharpe_ratio = 0.0

         total_return = (final_equity / env.initial_balance) - 1 if env.initial_balance > 0 else 0
         cum_returns = equity_curve / env.initial_balance if env.initial_balance > 0 else pd.Series([1.0]*len(equity_curve), index=equity_curve.index)
         peak = cum_returns.cummax(); drawdown = (cum_returns - peak) / peak
         max_drawdown = drawdown.min() if not drawdown.empty else 0

         if not trade_history_df.empty:
             trades = trade_history_df[trade_history_df['action'].str.contains("Close|Cover|Liquidation|Stop Loss|End", case=False)] # 更新匹配规则
             wins = trades[trades['step_pnl'] > 0].shape[0]; losses = trades[trades['step_pnl'] < 0].shape[0]
             total_trades = wins + losses; win_rate = wins / total_trades if total_trades > 0 else 0.0
         else: win_rate = 0.0

         results = {"Total Return": total_return, "Sharpe Ratio": sharpe_ratio, "Max Drawdown": max_drawdown, "Win Rate": win_rate, "Total Fees": env.total_fees, "Total Reward": total_reward}
    else:
         results = {"Total Return": 0, "Sharpe Ratio": 0, "Max Drawdown": 0, "Win Rate": np.nan, "Total Fees": 0, "Total Reward": 0}

    return results, step_history_df, trade_history_df, final_equity

