# hodl_strategy 和 sma_crossover_strategy 函数保持不变
print("定义基准策略...")

def hodl_strategy(df_raw, initial_balance=10000.0, commission_rate=0.001):
    """买入持有策略 (使用原始数据 df_raw)"""
    if df_raw.empty:
        print("HODL 策略错误：输入数据为空。")
        return {}, pd.DataFrame(), initial_balance

    balance = initial_balance
    position_size = 0
    entry_price = df_raw.iloc[0]['close']
    fees = 0
    history = [] # 用于记录权益变化

    if entry_price > 0:
        cost = balance
        fees = cost * commission_rate
        position_size = (balance - fees) / entry_price
        balance = 0
        history.append({'timestamp': df_raw.iloc[0]['timestamp'], 'action': 'Buy', 'price': entry_price, 'equity': initial_balance - fees})
    else:
        position_size = 0
        history.append({'timestamp': df_raw.iloc[0]['timestamp'], 'action': 'Hold', 'price': entry_price, 'equity': initial_balance})

    equity = initial_balance - fees
    for i in range(1, len(df_raw)):
         current_price = df_raw.iloc[i]['close']
         current_time = df_raw.iloc[i]['timestamp']
         equity = position_size * current_price
         history.append({'timestamp': current_time, 'action': 'Hold', 'price': current_price, 'equity': equity})

    final_equity = equity
    history_df = pd.DataFrame(history).set_index('timestamp')
    returns = history_df['equity'].pct_change().dropna()
    std_dev = returns.std()
    if len(returns) > 1 and std_dev > 1e-8:
        sharpe_ratio = (returns.mean() / std_dev) * np.sqrt(365 * 24 * 4)
    else: sharpe_ratio = 0.0

    total_return = (final_equity / initial_balance) - 1 if initial_balance > 0 else 0
    cum_returns = history_df['equity'] / initial_balance if initial_balance > 0 else pd.Series([1.0]*len(history_df), index=history_df.index)
    peak = cum_returns.cummax()
    drawdown = (cum_returns - peak) / peak
    max_drawdown = drawdown.min() if not drawdown.empty else 0

    results = {"Total Return": total_return, "Sharpe Ratio": sharpe_ratio, "Max Drawdown": max_drawdown, "Win Rate": np.nan, "Total Fees": fees}
    return results, history_df.reset_index(), final_equity

def sma_crossover_strategy(df_raw, initial_balance=10000.0, commission_rate=0.001,
                           short_window=20, long_window=50): # 默认值保持不变
    """简单移动平均线交叉策略 (支持多空)"""
    if df_raw.empty: return {}, pd.DataFrame(), pd.DataFrame(), initial_balance

    balance = initial_balance
    position = 0 # 0: 空仓, 1: 持有多头, -1: 持有空头
    position_size = 0.0
    entry_price = 0.0
    equity = initial_balance
    total_fees = 0.0
    step_history = []
    trade_history = []

    df_strat = df_raw.copy()
    # 使用传入的 window 参数
    df_strat['SMA_short'] = ta.sma(df_strat['close'], length=short_window)
    df_strat['SMA_long'] = ta.sma(df_strat['close'], length=long_window)
    df_strat = df_strat.dropna(subset=['SMA_short', 'SMA_long']).reset_index(drop=True)
    if df_strat.empty: return {}, pd.DataFrame(), pd.DataFrame(), initial_balance

    step_history.append({'timestamp': df_strat.iloc[0]['timestamp'], 'equity': initial_balance})

    for i in range(1, len(df_strat)):
        current_price = df_strat.iloc[i]['close']
        current_time = df_strat.iloc[i]['timestamp']
        signal = 0
        if i > 0:
            sma_short_prev = df_strat.iloc[i-1]['SMA_short']; sma_long_prev = df_strat.iloc[i-1]['SMA_long']
            sma_short_curr = df_strat.iloc[i]['SMA_short']; sma_long_curr = df_strat.iloc[i]['SMA_long']
            if sma_short_prev < sma_long_prev and sma_short_curr > sma_long_curr: signal = 1 # 金叉
            elif sma_short_prev > sma_long_prev and sma_short_curr < sma_long_curr: signal = -1 # 死叉

        action_taken = "Hold"; trade_price = np.nan; step_pnl = 0; fees = 0

        # --- 执行交易逻辑 ---
        # 金叉信号
        if signal == 1:
            if position == -1: # 如果持有空头，平仓
                step_pnl = (entry_price - current_price) * abs(position_size)
                fees = abs(position_size) * current_price * commission_rate # 平空是买入
                balance += step_pnl - fees
                total_fees += fees
                action_taken = "Cover Short"; trade_price = current_price
                trade_history.append({'timestamp': current_time, 'action': action_taken, 'price': trade_price, 'fees': fees, 'pnl': step_pnl})
                position = 0; position_size = 0; entry_price = 0
            if position == 0 and balance > 0: # 如果空仓，开多仓
                cost = balance # 用全部余额开仓
                fees = cost * commission_rate
                if current_price > 0:
                    position_size = (balance - fees) / current_price
                    balance = 0
                    total_fees += fees
                    position = 1
                    entry_price = current_price
                    action_taken = "Open Long"; trade_price = current_price
                    trade_history.append({'timestamp': current_time, 'action': action_taken, 'price': trade_price, 'fees': fees, 'pnl': 0})

        # 死叉信号
        elif signal == -1:
            if position == 1: # 如果持有多头，平仓
                step_pnl = (current_price - entry_price) * abs(position_size)
                fees = abs(position_size) * current_price * commission_rate # 平多是卖出
                balance += (position_size * current_price) - fees # 收到卖出金额，减去费用
                total_fees += fees
                action_taken = "Close Long"; trade_price = current_price
                trade_history.append({'timestamp': current_time, 'action': action_taken, 'price': trade_price, 'fees': fees, 'pnl': step_pnl})
                position = 0; position_size = 0; entry_price = 0
            if position == 0 and balance > 0: # 如果空仓，开空仓
                # 假设可以裸空，保证金要求简化为与做多相同（实际需要更复杂模型）
                cost = balance # 名义价值等于余额
                fees = cost * commission_rate
                if current_price > 0:
                    position_size = (balance - fees) / current_price # 借入并卖出的数量
                    balance = balance + (position_size * current_price) - fees # 余额增加卖出所得，减去费用 (简化模型)
                    total_fees += fees
                    position = -1
                    entry_price = current_price
                    action_taken = "Open Short"; trade_price = current_price
                    trade_history.append({'timestamp': current_time, 'action': action_taken, 'price': trade_price, 'fees': fees, 'pnl': 0})

        # 更新当前步的权益
        unrealized_pnl = 0
        if position == 1: unrealized_pnl = (current_price - entry_price) * abs(position_size)
        elif position == -1: unrealized_pnl = (entry_price - current_price) * abs(position_size)
        equity = balance + unrealized_pnl # 简化：未考虑空头保证金占用和利息
        step_history.append({'timestamp': current_time, 'equity': equity})


    # 结束时强制平仓
    final_price = df_strat.iloc[-1]['close']; current_time = df_strat.iloc[-1]['timestamp']
    if position == 1: # 平多
        step_pnl = (final_price - entry_price) * abs(position_size)
        fees = abs(position_size) * final_price * commission_rate
        balance += (position_size * final_price) - fees; total_fees += fees
        action_taken = "End Close Long"; trade_price = final_price
        trade_history.append({'timestamp': current_time, 'action': action_taken, 'price': trade_price, 'fees': fees, 'pnl': step_pnl})
    elif position == -1: # 平空
        step_pnl = (entry_price - final_price) * abs(position_size)
        fees = abs(position_size) * final_price * commission_rate
        balance += step_pnl - fees; total_fees += fees # 归还借入资产后的余额变化
        action_taken = "End Cover Short"; trade_price = final_price
        trade_history.append({'timestamp': current_time, 'action': action_taken, 'price': trade_price, 'fees': fees, 'pnl': step_pnl})
    position = 0; position_size = 0; entry_price = 0; equity = balance
    if step_history: step_history[-1]['equity'] = equity

    final_equity = equity
    step_history_df = pd.DataFrame(step_history).set_index('timestamp')
    returns = step_history_df['equity'].pct_change().dropna()
    std_dev = returns.std()
    if len(returns) > 1 and std_dev > 1e-8: sharpe_ratio = (returns.mean() / std_dev) * np.sqrt(365 * 24 * 4)
    else: sharpe_ratio = 0.0

    total_return = (final_equity / initial_balance) - 1 if initial_balance > 0 else 0
    cum_returns = step_history_df['equity'] / initial_balance if initial_balance > 0 else pd.Series([1.0]*len(step_history_df), index=step_history_df.index)
    peak = cum_returns.cummax(); drawdown = (cum_returns - peak) / peak
    max_drawdown = drawdown.min() if not drawdown.empty else 0

    # 胜率计算 (包含多空)
    trade_history_df = pd.DataFrame(trade_history)
    wins = 0
    total_trades = 0
    # 查找所有平仓交易
    close_trades = trade_history_df[trade_history_df['action'].str.contains("Close|Cover|End", case=False)]
    wins = close_trades[close_trades['pnl'] > 0].shape[0]
    total_trades = len(close_trades)
    win_rate = wins / total_trades if total_trades > 0 else 0

    results = {"Total Return": total_return, "Sharpe Ratio": sharpe_ratio, "Max Drawdown": max_drawdown, "Win Rate": win_rate, "Total Fees": total_fees}
    return results, step_history_df.reset_index(), trade_history_df, final_equity


