print("开始计算技术指标...")
def calculate_indicators(df):
    """计算所需的技术指标"""
    df_indicators = df.copy()
    # RSI (Relative Strength Index)
    df_indicators['RSI'] = ta.rsi(df_indicators['close'], length=164)
    # MFI (Money Flow Index)
    df_indicators['MFI'] = ta.mfi(df_indicators['high'], df_indicators['low'], df_indicators['close'], df_indicators['volume'], length=337)
    # MACD (Moving Average Convergence Divergence)
    macd = ta.macd(df_indicators['close'], fast=80, slow=120, signal=88)
    if macd is not None and not macd.empty:
        df_indicators['MACD'] = macd.iloc[:, 0] # MACD_12_26_9
        df_indicators['MACD_signal'] = macd.iloc[:, 2] # MACDs_12_26_9
        df_indicators['MACD_hist'] = macd.iloc[:, 1] # MACDh_12_26_9
    else:
        df_indicators['MACD'] = 0
        df_indicators['MACD_signal'] = 0
        df_indicators['MACD_hist'] = 0

    # SMA (Simple Moving Average) - 这里用作特征，而非策略本身
    df_indicators['SMA_50'] = ta.sma(df_indicators['close'], length=50)
    df_indicators['SMA_200'] = ta.sma(df_indicators['close'], length=200)
    # OBV (On-Balance Volume)
    df_indicators['OBV'] = ta.obv(df_indicators['close'], df_indicators['volume'])

    # 处理可能因计算产生的NaN值（例如窗口期不足）
    df_indicators = df_indicators.fillna(method='ffill') # 先用前值填充
    df_indicators = df_indicators.fillna(0) # 再用0填充开头的NaN

    # 选择用于状态的指标列 (根据需要调整)
    indicator_cols = ['RSI', 'MFI', 'MACD', 'MACD_signal', 'MACD_hist', 'SMA_50', 'SMA_200', 'OBV']
    # 也可以加入价格变化率等 (价格变化率可能与归一化的价格特征有些重叠)
    df_indicators['price_change'] = df_indicators['close'].pct_change().fillna(0)
    df_indicators['volume_change'] = df_indicators['volume'].pct_change().fillna(0)
    indicator_cols.extend(['price_change', 'volume_change'])

    # 确保所有指标列都是数值类型
    for col in indicator_cols:
         df_indicators[col] = pd.to_numeric(df_indicators[col], errors='coerce').fillna(0)
    # 新增：计算百分比回报率 z_t，用于奖励计算
    df_indicators['returns'] = df_indicators['close'].pct_change().fillna(0)
    return df_indicators, indicator_cols

